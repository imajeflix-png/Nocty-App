{
  "appId": "com.nocty.music",
  "appName": "Nocty",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0B0B0D",
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0B0D",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "backgroundColor": "#0B0B0D",
      "launchShowDuration": 1200,
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "BackgroundAudio": {
      "enabled": true,
      "wakeLock": true,
      "notificationTitle": "Nocty"
    },
    "MediaSession": {
      "foregroundService": true,
      "foregroundServiceType": "mediaPlayback",
      "channelId": "nocty_media_playback",
      "channelName": "Pemutar Musik Nocty",
      "bluetoothMediaButtonEvents": true
    }
  }
}
